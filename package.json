{
  "name": "timefarm-desktop",
  "version": "0.2.3",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "author": "TimeFarm contributors",
  "description": "Offline-first work time and earnings analytics desktop app.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && node --test electron/*.test.cjs",
    "test:db": "supabase test db --local",
    "test:coverage": "pnpm run test:coverage:renderer && pnpm run test:coverage:electron",
    "test:coverage:renderer": "vitest run --coverage",
    "test:coverage:electron": "node --test --experimental-test-coverage --test-coverage-include=\"electron/*.cjs\" --test-coverage-exclude=\"electron/*.test.cjs\" --test-coverage-exclude=\"electron/main.cjs\" --test-coverage-lines=87 --test-coverage-branches=70 --test-coverage-functions=92 \"electron/*.test.cjs\"",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format:check": "prettier --check .",
    "check:electron": "tsc -p tsconfig.electron.json",
    "check:bundle": "node scripts/check-bundle-budget.cjs",
    "check:workflows": "node scripts/check-workflow-pins.cjs",
    "check:win:fuses": "node scripts/check-electron-fuses.cjs",
    "check:db": "supabase db lint --local --level error",
    "check:cloud": "node scripts/check-cloud-contract.cjs",
    "smoke:win:packaged": "node scripts/smoke-packaged-app.cjs",
    "smoke:win:installer": "node scripts/smoke-windows-installer.cjs",
    "pack:win": "node scripts/prepare-runtime-config.cjs && node scripts/check-bundled-runtime-config.cjs cloud && pnpm build && node scripts/run-electron-builder-with-retry.cjs --win nsis --x64 --publish never && pnpm check:win:fuses && node scripts/check-packaged-runtime-config.cjs cloud",
    "pack:win:offline": "node scripts/prepare-offline-runtime-config.cjs && node scripts/check-bundled-runtime-config.cjs offline && pnpm build && node scripts/run-electron-builder-with-retry.cjs --win nsis --x64 --publish never && pnpm check:win:fuses && node scripts/check-packaged-runtime-config.cjs offline",
    "pack:win:dir": "node scripts/prepare-offline-runtime-config.cjs && node scripts/check-bundled-runtime-config.cjs offline && pnpm build && electron-builder --win dir --x64 --publish never && pnpm check:win:fuses && node scripts/check-packaged-runtime-config.cjs offline"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/supabase-js": "^2.112.2",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "stylelint": "^17.16.0",
    "supabase": "2.119.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.timefarm.desktop",
    "productName": "TimeFarm",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json",
      "!electron/**/*.test.cjs"
    ],
    "icon": "assets/timefarm-avatar.ico",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "protocols": [
      {
        "name": "TimeFarm OAuth",
        "schemes": [
          "timefarm"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "artifactName": "${productName}-${version}-Setup.${ext}"
  }
}
