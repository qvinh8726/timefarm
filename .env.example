# Do not commit real values. Electron main reads TIMEFARM_* at launch.
# Supabase requires a project URL and publishable/anon key only; never use a service-role key here.
TIMEFARM_SUPABASE_URL=
TIMEFARM_SUPABASE_ANON_KEY=

# WORKLY_* names remain accepted for existing local setups.
WORKLY_SUPABASE_URL=
WORKLY_SUPABASE_ANON_KEY=

# Optional replaceable FX provider. The default is Frankfurter's public latest-rates endpoint.
TIMEFARM_FX_API_URL=https://api.frankfurter.dev/v1/latest
TIMEFARM_FX_PROVIDER_NAME=Frankfurter

# WORKLY_* names remain accepted for existing local setups.
WORKLY_FX_API_URL=https://api.frankfurter.dev/v1/latest
WORKLY_FX_PROVIDER_NAME=Frankfurter
